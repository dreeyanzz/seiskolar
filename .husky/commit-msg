#!/usr/bin/env sh
# Rejects a commit message that would break the history on main: a leading
# byte-order mark (Windows PowerShell 5.1 adds one), or a subject that is not
# `type(scope): summary`. See AGENTS.md, "Git and pull requests".
msg_file="$1"

if [ "$(head -c 3 "$msg_file" | od -An -tx1 | tr -d ' \n')" = "efbbbf" ]; then
  echo "commit-msg: the message starts with a byte-order mark (BOM)."
  echo "Use git commit -m, a Git Bash heredoc, or a UTF-8 file without BOM."
  exit 1
fi

subject=$(head -n 1 "$msg_file")
case "$subject" in
  "Merge "* | "Revert \""* | "fixup! "* | "squash! "*) exit 0 ;;
esac

if ! printf '%s' "$subject" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)\((srs|swimlanes|low-fi|hi-fi|repo)\)!?: .+'; then
  echo "commit-msg: the subject must look like 'type(scope): summary'."
  echo "Example: feat(swimlanes): add the filing workflow"
  echo "Types:  feat fix docs style refactor perf test build ci chore revert"
  echo "Scopes: srs swimlanes low-fi hi-fi repo"
  exit 1
fi
